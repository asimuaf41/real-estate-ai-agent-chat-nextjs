# Server-side only — never prefix secrets with NEXT_PUBLIC_
ANTHROPIC_API_KEY=
WEATHER_API_KEY=
TAVILY_API_KEY=

# Must be a live project URL (DNS must resolve). Paused/deleted projects cause RAG/memory failures.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Publishable/anon key for Auth SSR + browser session (safe with RLS; NOT the service role).
# Prefer SUPABASE_ANON_KEY. SUPABASE_KEY is accepted as an alias.
SUPABASE_ANON_KEY=
# Optional alias if you already use this name:
# SUPABASE_KEY=

# Optional; legacy default only — authenticated traffic uses supabase.auth.getUser().
DEFAULT_USER_ID=

# Required on Vercel for RAG/memory embeddings (all-MiniLM-L6-v2, 384-dim).
# Create at https://huggingface.co/settings/tokens with Inference Providers permission.
HF_TOKEN=

# Optional: force provider — "huggingface" | "xenova"
# EMBEDDING_PROVIDER=

# After creating a new Supabase project, run data/supabase-schema.sql in the SQL Editor.

# Public site URL used in auth emails / OAuth redirects (no trailing slash).
# Required on Vercel production, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional server alias for the same value:
# SITE_URL=

# Optional: only set if the frontend must call a different origin.
# Leave unset for same-origin /api routes (recommended on Vercel).
# NEXT_PUBLIC_API_BASE_URL=

# Optional legacy fallbacks (not required if SUPABASE_URL + SUPABASE_ANON_KEY/SUPABASE_KEY are set):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
