# Server-side only — never prefix these with NEXT_PUBLIC_
ANTHROPIC_API_KEY=
WEATHER_API_KEY=
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback if service role key is unavailable (RLS must allow writes)
SUPABASE_KEY=
# Optional; defaults to asim-ali-001
DEFAULT_USER_ID=

# Optional: only set if the frontend must call a different origin.
# Leave unset for same-origin /api routes (recommended on Vercel).
# NEXT_PUBLIC_API_BASE_URL=
